<Window 
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="NRA Network - DNS Optimizer" Height="800" Width="1080"
        Background="#1E1E2E" WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI">
    <Window.Resources>
        <!-- Button Style with hover border glow -->
        <Style TargetType="Button">
            <Setter Property="Background" Value="#282A36"/>
            <Setter Property="Foreground" Value="#CDD6F4"/>
            <Setter Property="Padding" Value="12,7"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="BtnBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="BtnBorder" Property="Background" Value="#45475A"/>
                                <Setter TargetName="BtnBorder" Property="BorderBrush" Value="#585B70"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="BtnBorder" Property="Background" Value="#313244"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="BtnBorder" Property="Background" Value="#181825"/>
                                <Setter Property="Foreground" Value="#6C7086"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Default TextBlock -->
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#CDD6F4"/>
        </Style>

        <!-- DataGrid -->
        <Style TargetType="DataGrid">
            <Setter Property="Background" Value="#282A36"/>
            <Setter Property="Foreground" Value="#CDD6F4"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#585B70"/>
            <Setter Property="RowBackground" Value="#282A36"/>
            <Setter Property="AlternatingRowBackground" Value="#1E1E2E"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="GridLinesVisibility" Value="None"/>
            <Setter Property="AutoGenerateColumns" Value="False"/>
            <Setter Property="CanUserAddRows" Value="False"/>
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="SelectionMode" Value="Single"/>
        </Style>

        <!-- DataGrid Column Header -->
        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#181825"/>
            <Setter Property="Foreground" Value="#89B4FA"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="BorderBrush" Value="#313244"/>
            <Setter Property="BorderThickness" Value="0,0,1,1"/>
        </Style>

        <!-- DataGrid Cell -->
        <Style TargetType="DataGridCell">
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridCell">
                        <Border Padding="{TemplateBinding Padding}" Background="{TemplateBinding Background}">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#313244"/>
                    <Setter Property="Foreground" Value="#CDD6F4"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- DataGrid Row hover -->
        <Style TargetType="DataGridRow">
            <Setter Property="BorderThickness" Value="0"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#313244"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Rounded Progress Bar -->
        <Style x:Key="RoundedProgressBar" TargetType="ProgressBar">
            <Setter Property="Height" Value="6"/>
            <Setter Property="Maximum" Value="100"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Border Background="#313244" CornerRadius="3" ClipToBounds="True">
                            <Grid>
                                <Border x:Name="PART_Track"/>
                                <Border x:Name="PART_Indicator" HorizontalAlignment="Left" CornerRadius="3">
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                            <GradientStop Color="#89B4FA" Offset="0"/>
                                            <GradientStop Color="#B4BEFE" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Border.Background>
                                </Border>
                            </Grid>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="140"/>
        </Grid.RowDefinitions>
        
        <!-- Header -->
        <Grid Grid.Row="0" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="&#x25C9;" FontSize="22" Foreground="#89B4FA" Margin="0,0,8,0" VerticalAlignment="Center"/>
                <TextBlock Text="NRA Network" FontSize="22" FontWeight="Bold" Foreground="#CDD6F4" VerticalAlignment="Center"/>
                <TextBlock Text="DNS Optimizer" FontSize="22" FontWeight="Light" Foreground="#A6ADC8" Margin="6,0,0,0" VerticalAlignment="Center"/>
                <Border Background="#313244" CornerRadius="10" Padding="8,3" Margin="15,0,0,0" VerticalAlignment="Center"
                        BorderBrush="#585B70" BorderThickness="1">
                    <TextBlock x:Name="AdapterBadge" Text="Detecting..." FontSize="11" Foreground="#A6E3A1"/>
                </Border>
                <Border Background="#313244" CornerRadius="10" Padding="8,3" Margin="6,0,0,0" VerticalAlignment="Center"
                        BorderBrush="#585B70" BorderThickness="1">
                    <TextBlock x:Name="AdminBadge" Text="Admin: ..." FontSize="11" Foreground="#A6E3A1"/>
                </Border>
            </StackPanel>
            <Button x:Name="BtnRunBenchmark" Grid.Column="1" Background="#89B4FA" Foreground="#1E1E2E" FontWeight="Bold" FontSize="14" Padding="18,9"
                    BorderBrush="#B4BEFE" BorderThickness="1">
                <TextBlock Text="Run Full Benchmark"/>
            </Button>
        </Grid>

        <!-- Stats Row -->
        <Grid Grid.Row="1" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            
            <!-- Top DNS -->
            <Border Grid.Column="0" Background="#282A36" CornerRadius="10" Padding="16" Margin="0,0,6,0"
                    BorderBrush="#585B70" BorderThickness="1">
                <Border.Effect>
                    <DropShadowEffect Color="#11111B" BlurRadius="12" ShadowDepth="2" Opacity="0.25" Direction="270"/>
                </Border.Effect>
                <StackPanel>
                    <TextBlock Text="TOP DNS PROVIDER" FontSize="10" Foreground="#6C7086" FontWeight="SemiBold" Margin="0,0,0,6"/>
                    <TextBlock x:Name="StatTopDns" Text="---" FontSize="17" FontWeight="Bold" Foreground="#89B4FA" TextTrimming="CharacterEllipsis"/>
                </StackPanel>
            </Border>
            
            <!-- Lowest Ping -->
            <Border Grid.Column="1" Background="#282A36" CornerRadius="10" Padding="16" Margin="6,0,6,0"
                    BorderBrush="#585B70" BorderThickness="1">
                <Border.Effect>
                    <DropShadowEffect Color="#11111B" BlurRadius="12" ShadowDepth="2" Opacity="0.25" Direction="270"/>
                </Border.Effect>
                <StackPanel>
                    <TextBlock Text="LOWEST PING (ms)" FontSize="10" Foreground="#6C7086" FontWeight="SemiBold" Margin="0,0,0,6"/>
                    <TextBlock x:Name="StatLowestPing" Text="---" FontSize="17" FontWeight="Bold" Foreground="#A6E3A1"/>
                </StackPanel>
            </Border>

            <!-- DNS Resolve -->
            <Border Grid.Column="2" Background="#282A36" CornerRadius="10" Padding="16" Margin="6,0,6,0"
                    BorderBrush="#585B70" BorderThickness="1">
                <Border.Effect>
                    <DropShadowEffect Color="#11111B" BlurRadius="12" ShadowDepth="2" Opacity="0.25" Direction="270"/>
                </Border.Effect>
                <StackPanel>
                    <TextBlock Text="DNS RESOLVE (ms)" FontSize="10" Foreground="#6C7086" FontWeight="SemiBold" Margin="0,0,0,6"/>
                    <TextBlock x:Name="StatDnsResolve" Text="---" FontSize="17" FontWeight="Bold" Foreground="#FAB387"/>
                </StackPanel>
            </Border>

            <!-- MTU -->
            <Border Grid.Column="3" Background="#282A36" CornerRadius="10" Padding="16" Margin="6,0,0,0"
                    BorderBrush="#585B70" BorderThickness="1">
                <Border.Effect>
                    <DropShadowEffect Color="#11111B" BlurRadius="12" ShadowDepth="2" Opacity="0.25" Direction="270"/>
                </Border.Effect>
                <StackPanel>
                    <TextBlock Text="OPTIMAL MTU" FontSize="10" Foreground="#6C7086" FontWeight="SemiBold" Margin="0,0,0,6"/>
                    <TextBlock x:Name="StatMtu" Text="---" FontSize="17" FontWeight="Bold" Foreground="#CBA6F7"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Main Content -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="200"/>
            </Grid.ColumnDefinitions>

            <!-- Table -->
            <Border Grid.Column="0" Background="#282A36" CornerRadius="10" Padding="10" Margin="0,0,10,0"
                    BorderBrush="#585B70" BorderThickness="1">
                <Border.Effect>
                    <DropShadowEffect Color="#11111B" BlurRadius="8" ShadowDepth="1" Opacity="0.2" Direction="270"/>
                </Border.Effect>
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="Double-click a row to apply its DNS" FontSize="11" Foreground="#7F849C" Margin="4,0,0,6"/>
                    <DataGrid x:Name="DnsDataGrid">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="#" Binding="{Binding Rank}" Width="35"/>
                        <DataGridTextColumn Header="Provider" Binding="{Binding Name}" Width="*"/>
                        <DataGridTextColumn Header="Category" Binding="{Binding Category}" Width="70">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Category}" Value="Fast">
                                            <Setter Property="Foreground" Value="#89B4FA"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Category}" Value="AdBlock">
                                            <Setter Property="Foreground" Value="#A6E3A1"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Category}" Value="Privacy">
                                            <Setter Property="Foreground" Value="#F5C2E7"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Category}" Value="Malware">
                                            <Setter Property="Foreground" Value="#CBA6F7"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Category}" Value="Global">
                                            <Setter Property="Foreground" Value="#CBA6F7"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Category}" Value="Custom">
                                            <Setter Property="Foreground" Value="#94E2D5"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="IP" Binding="{Binding IP}" Width="115"/>
                        <DataGridTextColumn Header="Badges" Binding="{Binding Badges}" Width="80">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="#B4BEFE"/>
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="Ping" Binding="{Binding PingStr}" Width="65">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding PingTier}" Value="good">
                                            <Setter Property="Foreground" Value="#A6E3A1"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding PingTier}" Value="mid">
                                            <Setter Property="Foreground" Value="#FAB387"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding PingTier}" Value="high">
                                            <Setter Property="Foreground" Value="#F38BA8"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="Jitter" Binding="{Binding JitterStr}" Width="65"/>
                        <DataGridTextColumn Header="Loss" Binding="{Binding LossStr}" Width="55"/>
                        <DataGridTextColumn Header="DNS" Binding="{Binding DnsTimeStr}" Width="70">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding DnsTier}" Value="good">
                                            <Setter Property="Foreground" Value="#A6E3A1"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding DnsTier}" Value="mid">
                                            <Setter Property="Foreground" Value="#FAB387"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding DnsTier}" Value="high">
                                            <Setter Property="Foreground" Value="#F38BA8"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="Score" Binding="{Binding ScoreStr}" Width="60"/>
                        <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="75">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Status}" Value="OK">
                                            <Setter Property="Foreground" Value="#A6E3A1"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Status}" Value="FAIL">
                                            <Setter Property="Foreground" Value="#F38BA8"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Status}" Value="DNS FAIL">
                                            <Setter Property="Foreground" Value="#F38BA8"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Status}" Value="HIJACKED">
                                            <Setter Property="Foreground" Value="#F9E2AF"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Status}" Value="HIGH LOSS">
                                            <Setter Property="Foreground" Value="#FAB387"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                    </DataGrid.Columns>
                </DataGrid>
                </DockPanel>
            </Border>

            <!-- Sidebar -->
            <Border Grid.Column="1" Background="#282A36" CornerRadius="10" Padding="12"
                    BorderBrush="#585B70" BorderThickness="1">
                <Border.Effect>
                    <DropShadowEffect Color="#11111B" BlurRadius="8" ShadowDepth="1" Opacity="0.2" Direction="270"/>
                </Border.Effect>
                <StackPanel>
                    <TextBlock Text="Quick Actions" FontSize="14" FontWeight="Bold" Foreground="#CDD6F4" Margin="0,0,0,10"/>

                    <!-- DNS group -->
                    <TextBlock Text="DNS" FontSize="10" FontWeight="Bold" Foreground="#6C7086" Margin="0,0,0,4"/>
                    <Button x:Name="BtnApplyFastest"><TextBlock Text="Apply #1 Fastest"/></Button>
                    <Button x:Name="BtnApplyAdblock"><TextBlock Text="Apply Best AdBlock"/></Button>
                    <Button x:Name="BtnApplyPrivacy"><TextBlock Text="Apply Best Privacy"/></Button>

                    <!-- Network group -->
                    <TextBlock Text="NETWORK" FontSize="10" FontWeight="Bold" Foreground="#6C7086" Margin="0,10,0,4"/>
                    <Button x:Name="BtnOptimizeTcp"><TextBlock Text="Optimize TCP/Registry"/></Button>
                    <Button x:Name="BtnAutoMtu"><TextBlock Text="Auto-Detect MTU"/></Button>
                    <Button x:Name="BtnTestGames"><TextBlock Text="Test Game Latency"/></Button>

                    <!-- System group -->
                    <TextBlock Text="SYSTEM" FontSize="10" FontWeight="Bold" Foreground="#6C7086" Margin="0,10,0,4"/>
                    <Button x:Name="BtnResetDhcp"><TextBlock Text="Reset to DHCP"/></Button>
                    <Button x:Name="BtnExport"><TextBlock Text="Export Telemetry"/></Button>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Progress -->
        <ProgressBar x:Name="ProgBar" Grid.Row="3" Margin="0,10,0,10" Value="0"
                     Style="{StaticResource RoundedProgressBar}"/>

        <!-- Console -->
        <Border Grid.Row="4" Background="#11111B" CornerRadius="10" Padding="10"
                BorderBrush="#313244" BorderThickness="1">
            <ScrollViewer x:Name="ConsoleScroll" VerticalScrollBarVisibility="Auto">
                <TextBlock x:Name="ConsoleOutput" FontFamily="Cascadia Mono,Consolas,Courier New" FontSize="11.5" Foreground="#A6ADC8" TextWrapping="Wrap"/>
            </ScrollViewer>
        </Border>
    </Grid>
</Window>
