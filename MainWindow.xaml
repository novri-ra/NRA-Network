<Window 
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DNS Optimizer (God-Mode v2)" Height="768" Width="1024"
        Background="#1E1E2E" WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Background" Value="#282A36"/>
            <Setter Property="Foreground" Value="#CDD6F4"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#45475A"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#CDD6F4"/>
        </Style>
        <Style TargetType="DataGrid">
            <Setter Property="Background" Value="#282A36"/>
            <Setter Property="Foreground" Value="#CDD6F4"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="RowBackground" Value="#282A36"/>
            <Setter Property="AlternatingRowBackground" Value="#1E1E2E"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="GridLinesVisibility" Value="None"/>
            <Setter Property="AutoGenerateColumns" Value="False"/>
            <Setter Property="CanUserAddRows" Value="False"/>
            <Setter Property="IsReadOnly" Value="True"/>
        </Style>
        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#181825"/>
            <Setter Property="Foreground" Value="#89B4FA"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>
        <Style TargetType="DataGridCell">
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridCell">
                        <Border Padding="{TemplateBinding Padding}" Background="{TemplateBinding Background}">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="150"/>
        </Grid.RowDefinitions>
        
        <!-- Header -->
        <Grid Grid.Row="0" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="&#x25C9;" FontSize="24" Foreground="#89B4FA" Margin="0,0,10,0" VerticalAlignment="Center"/>
                <TextBlock Text="DNS Optimizer GUI" FontSize="24" FontWeight="Bold" Foreground="#89B4FA" VerticalAlignment="Center"/>
                <Border Background="#313244" CornerRadius="4" Padding="5,2" Margin="15,0,0,0" VerticalAlignment="Center">
                    <TextBlock x:Name="AdapterBadge" Text="Detecting Adapter..." FontSize="12" Foreground="#A6E3A1"/>
                </Border>
                <Border Background="#313244" CornerRadius="4" Padding="5,2" Margin="10,0,0,0" VerticalAlignment="Center">
                    <TextBlock x:Name="AdminBadge" Text="Admin: OK" FontSize="12" Foreground="#A6E3A1"/>
                </Border>
            </StackPanel>
            <Button x:Name="BtnRunBenchmark" Grid.Column="1" Background="#89B4FA" Foreground="#1E1E2E" FontWeight="Bold" FontSize="14" Padding="15,8">
                <TextBlock Text="Run Full Benchmark"/>
            </Button>
        </Grid>

        <!-- Stats Row -->
        <Grid Grid.Row="1" Margin="0,0,0,15">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            
            <Border Grid.Column="0" Background="#282A36" CornerRadius="8" Padding="15" Margin="0,0,5,0">
                <StackPanel>
                    <TextBlock Text="Top DNS Provider" FontSize="12" Foreground="#A6ADC8" Margin="0,0,0,5"/>
                    <TextBlock x:Name="StatTopDns" Text="---" FontSize="18" FontWeight="Bold" Foreground="#89B4FA" TextTrimming="CharacterEllipsis"/>
                </StackPanel>
            </Border>
            
            <Border Grid.Column="1" Background="#282A36" CornerRadius="8" Padding="15" Margin="5,0,5,0">
                <StackPanel>
                    <TextBlock Text="Lowest Ping (ms)" FontSize="12" Foreground="#A6ADC8" Margin="0,0,0,5"/>
                    <TextBlock x:Name="StatLowestPing" Text="---" FontSize="18" FontWeight="Bold" Foreground="#A6E3A1"/>
                </StackPanel>
            </Border>

            <Border Grid.Column="2" Background="#282A36" CornerRadius="8" Padding="15" Margin="5,0,5,0">
                <StackPanel>
                    <TextBlock Text="DNS Resolve (ms)" FontSize="12" Foreground="#A6ADC8" Margin="0,0,0,5"/>
                    <TextBlock x:Name="StatDnsResolve" Text="---" FontSize="18" FontWeight="Bold" Foreground="#FAB387"/>
                </StackPanel>
            </Border>

            <Border Grid.Column="3" Background="#282A36" CornerRadius="8" Padding="15" Margin="5,0,0,0">
                <StackPanel>
                    <TextBlock Text="Optimal MTU Value" FontSize="12" Foreground="#A6ADC8" Margin="0,0,0,5"/>
                    <TextBlock x:Name="StatMtu" Text="---" FontSize="18" FontWeight="Bold" Foreground="#CBA6F7"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Main Content -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="220"/>
            </Grid.ColumnDefinitions>

            <!-- Table -->
            <Border Grid.Column="0" Background="#282A36" CornerRadius="8" Padding="10" Margin="0,0,10,0">
                <StackPanel>
                    <TextBlock Text="(Double-click a row to apply its DNS server)" FontSize="11" Foreground="#A6ADC8" Margin="0,0,0,5" HorizontalAlignment="Right"/>
                    <DataGrid x:Name="DnsDataGrid" Height="360">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="#" Binding="{Binding Rank}" Width="Auto"/>
                        <DataGridTextColumn Header="Provider" Binding="{Binding Name}" Width="*"/>
                        <DataGridTextColumn Header="Category" Binding="{Binding Category}" Width="Auto"/>
                        <DataGridTextColumn Header="IP" Binding="{Binding IP}" Width="120"/>
                        <DataGridTextColumn Header="Badges" Binding="{Binding Badges}" Width="Auto"/>
                        <DataGridTextColumn Header="Ping" Binding="{Binding PingStr}" Width="Auto"/>
                        <DataGridTextColumn Header="Jitter" Binding="{Binding JitterStr}" Width="Auto"/>
                        <DataGridTextColumn Header="Loss" Binding="{Binding LossStr}" Width="Auto"/>
                        <DataGridTextColumn Header="DNS Time" Binding="{Binding DnsTimeStr}" Width="Auto"/>
                        <DataGridTextColumn Header="Score" Binding="{Binding ScoreStr}" Width="Auto"/>
                        <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="Auto"/>
                    </DataGrid.Columns>
                </DataGrid>
                </StackPanel>
            </Border>

            <!-- Sidebar -->
            <Border Grid.Column="1" Background="#282A36" CornerRadius="8" Padding="10">
                <StackPanel>
                    <TextBlock Text="Quick Actions" FontSize="14" FontWeight="Bold" Foreground="#A6ADC8" Margin="0,0,0,10"/>
                    <Button x:Name="BtnApplyFastest" Margin="0,0,0,5"><TextBlock Text="Apply #1 Fastest DNS"/></Button>
                    <Button x:Name="BtnApplyAdblock" Margin="0,0,0,5"><TextBlock Text="Apply Best AdBlock"/></Button>
                    <Button x:Name="BtnApplyPrivacy" Margin="0,0,0,5"><TextBlock Text="Apply Best Privacy"/></Button>
                    <Separator Background="#45475A" Margin="0,5"/>
                    <Button x:Name="BtnOptimizeTcp" Margin="0,0,0,5"><TextBlock Text="Optimize TCP/Registry"/></Button>
                    <Button x:Name="BtnAutoMtu" Margin="0,0,0,5"><TextBlock Text="Auto-Detect MTU"/></Button>
                    <Button x:Name="BtnTestGames" Margin="0,0,0,5"><TextBlock Text="Test Game Latency"/></Button>
                    <Separator Background="#45475A" Margin="0,5"/>
                    <Button x:Name="BtnResetDhcp" Margin="0,0,0,5"><TextBlock Text="Reset to DHCP"/></Button>
                    <Button x:Name="BtnExport"><TextBlock Text="Export Telemetry"/></Button>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Progress -->
        <ProgressBar x:Name="ProgBar" Grid.Row="3" Height="4" Margin="0,10,0,10" Background="#313244" Foreground="#89B4FA" Maximum="100" Value="0"/>

        <!-- Console -->
        <Border Grid.Row="4" Background="#11111B" CornerRadius="8" Padding="10">
            <ScrollViewer x:Name="ConsoleScroll" VerticalScrollBarVisibility="Auto">
                <TextBlock x:Name="ConsoleOutput" FontFamily="Consolas" FontSize="12" Foreground="#A6ADC8" TextWrapping="Wrap"/>
            </ScrollViewer>
        </Border>
    </Grid>
</Window>